                  {% if billing_address.first_name %}Hi {{ billing_address.first_name }},{% else %}Hello,{% endif %}
                </div>
                <div style="margin-top:8px; font-size:14px; line-height:1.6; color:#6b6b70;">
                  Here's your order <strong style="color:#141414;">{{ name }}</strong>, created {{ created_at | date: "%B %-d, %Y" }}.
                  Use the button below to check out securely.
