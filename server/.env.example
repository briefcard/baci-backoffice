PORT=8080
APP_URL=http://localhost:5173

# --- Shopify ---
SHOPIFY_STORE=769684-2.myshopify.com
SHOPIFY_API_VERSION=2025-01
# OAuth app credentials (Client ID / Secret). Install once at /auth/shopify/install to mint a token.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_SCOPES=read_products,write_products,read_inventory,write_inventory,read_locations,read_draft_orders,write_draft_orders,read_customers,write_customers,read_orders
# Optional: a static Admin API token (custom app). If set, it's used instead of OAuth.
SHOPIFY_ADMIN_TOKEN=
# Webhook HMAC secret — defaults to SHOPIFY_API_SECRET when blank.
SHOPIFY_WEBHOOK_SECRET=

# --- Confirmed business settings (defaults shown) ---
SELLABLE_LOCATION_IDS=gid://shopify/Location/104277705016
LOW_STOCK_THRESHOLD=10
DEFAULT_WHOLESALE_PCT=50

# Per-event access code for the PUBLIC (QR) customer order form. Customers open
# https://<app>/?form=<code> on their own phones. Unset = public form disabled
# (kiosk form mode on rep tablets always works). Rotate per tradeshow.
ORDER_FORM_CODE=

# --- M1 fast start: skip auth so you only need the Shopify token to see the lookup UI ---
AUTH_DISABLED=true

# --- Interim email+password auth (no Resend needed). JSON list of reps. ---
# REP_LOGINS=[{"email":"jane@bacimilanousa.com","name":"Jane","password":"changeme1"},{"email":"rob@bacimilanousa.com","name":"Rob","password":"changeme2"}]

# --- WhatsApp agent (gomehagent) machine auth ---
# Bearer token for the owner's WhatsApp agent to use the inbound + documents API
# (Authorization: Bearer <token>). Unset = agent access disabled. Generate long + random.
AGENT_API_TOKEN=
# Per-shipment required customs/freight documents (checklist). Default shown.
REQUIRED_DOCS=commercial_invoice,packing_list,bill_of_lading,7501

# --- WhatsApp-agent integration (gomehagent, separate Render service) ---
# Bearer token the agent sends as `Authorization: Bearer <token>` to reach the inbound +
# documents endpoints only (never orders/customers/checkout). Generate a long random string
# and set the SAME value here and in the gomehagent env. Unset = agent access disabled.
AGENT_API_TOKEN=
# Per-shipment required-document set (checklist is "complete" once all are received-or-better).
REQUIRED_DOCS=commercial_invoice,packing_list,bill_of_lading,7501

# --- M2 auth + infra (set when ready) ---
JWT_SECRET=change-me-to-a-long-random-string
DATABASE_URL=
RESEND_API_KEY=
MAGIC_LINK_FROM=Baci Reps <reps@bacimilanousa.com>

# ---- Document intake from Google + AI reading (history import, Documents inbox) ----
# Read-only use of ONE Google account: the Baci mailbox. GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET
# are the same OAuth client the email agent uses; GOOGLE_REFRESH_TOKEN is the Baci account's
# refresh token ONLY (not the agent's whole multi-account JSON). With GOOGLE_ACCOUNT_EMAIL set,
# the app refuses to read anything if the token belongs to a different address.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_ACCOUNT_EMAIL=
# Drive folder the order folders live under (default B2B).
GOOGLE_DRIVE_ROOT=B2B
# Claude reads the documents the app's own parser does not know (forwarder, customs, freight).
# Without it only Baci orders, invoices and packing lists are read.
ANTHROPIC_API_KEY=
# INTAKE_MODEL=claude-opus-5-5
